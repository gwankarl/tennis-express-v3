# Optional bind address. Defaults to 127.0.0.1.
HOST=127.0.0.1

# Optional listen port. Defaults to 3000; valid range is 1-65535.
PORT=3000

# Replace these placeholders with a URL-encoded PostgreSQL connection string.
DATABASE_URL=postgresql://tennis_xpress_app_dev:URL_ENCODED_PASSWORD@127.0.0.1:5432/tennis_xpress_app_dev

# Used only by explicit test-database migration commands.
TEST_DATABASE_URL=postgresql://tennis_xpress_app_test:URL_ENCODED_PASSWORD@127.0.0.1:5432/tennis_xpress_app_test

# Local frontend origin used to build verification and password reset links.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Local filesystem adapter only; keep evidence outside the repository and public directories.
# Production S3-compatible storage, bucket policy, and lifecycle rules are deployment work.
SELLER_EVIDENCE_STORAGE_DIR=C:/tx-private/tennis-xpress/evidence

# Keep false until Mailtrap Email Sandbox credentials are configured in backend/.env.
EMAIL_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=REPLACE_WITH_MAILTRAP_SANDBOX_USERNAME
SMTP_PASS=REPLACE_WITH_MAILTRAP_SANDBOX_PASSWORD
EMAIL_FROM=no-reply@example.test

# Absolute path to the protected operator public-key and environment registry; never commit the registry.
ADMIN_OPERATOR_KEYS_FILE=C:/ProgramData/TennisXpress/admin-operators.json

# Optional local administrator MFA settings. Set all three in backend/.env before enabling MFA.
# Generate each key separately with: openssl rand -base64 32
ADMIN_MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
ADMIN_MFA_KEY_VERSION=v1
ADMIN_MFA_ATTEMPT_HMAC_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY
