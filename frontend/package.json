{
  "name": "@tennis-xpress/frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "react-router dev",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc --project tsconfig.json",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "test": "npm run test:node && npm run test:dom",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:dom": "vitest run --config vitest.dom.config.ts"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
