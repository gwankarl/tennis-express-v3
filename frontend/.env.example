# Server-only URL of the backend origin. Do not include /api/v1.
BACKEND_API_BASE_URL=http://127.0.0.1:3000

# Backend request timeout in milliseconds; must be a positive integer.
BACKEND_API_TIMEOUT_MS=5000

# Exact browser origin used for same-origin form protection; do not add a path.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Server-only HMAC key; replace locally with at least 32 random bytes.
CSRF_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
